# PrimeBill Frontend — environment variables
# Copy to `.env` (or `.env.local` for local dev) and adjust as needed.
#   cp .env.example .env.local

# Base URL of the PrimeBill ISP Platform Laravel API (backend).
# Default: http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ── Branding (source of truth: src/config/brand.js) ─────────────────────────
# Short brand name, full product name, and all-caps display form.
# Override only if you need a custom public product name.
# VITE_BRAND_NAME="PrimeBill"
# VITE_PRODUCT_NAME="PrimeBill ISP Platform"
# VITE_DISPLAY_NAME="PRIMEBILL ISP PLATFORM"
# VITE_DEFAULT_COMPANY="PrimeBill ISP"
